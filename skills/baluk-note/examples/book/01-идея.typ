// Глава книги: начинается с импорта, «=» — глава («Глава 1»), «==» — раздел.
#import "/_baluk/lib.typ": *

= Идея
#lead[
  Сумму на отрезке массива можно получать за одно вычитание, если заранее
  посчитать суммы всех префиксов. Опираемся только на массивы.
]
#plan([строить массив префиксных сумм], [отвечать на запрос суммы за $O(1)$])

== Префиксы <sec-prefix>

#definition(title: "префиксная сумма")[
  $P_i = a_0 + a_1 + dots + a_(i - 1)$, $P_0 = 0$.
]

#formula[$ sum_(i = l)^(r) a_i = P_(r + 1) - P_l $]

#example(title: "сумма на отрезке")[
  $a = (3, 1, 4, 1, 5)$, найти сумму на $[1, 3]$.

  #step[Префиксы] $P = (0, 3, 4, 8, 9, 14)$.

  #step[Разность] $P_4 - P_1 = 9 - 3 = 6$.

  #answer[$6$]
]

#pitfall[Сдвиг на единицу: берут $P_r - P_l$ и теряют $a_r$.]

#summary([Префиксы считаются за один проход.], [Запрос — одно вычитание.])
#quiz(([Чему равно $P_0$?], [$0$]))
