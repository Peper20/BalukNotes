// Ссылки между заметками хранилища.
//
//   #см("Сеть/SSH")                         → «SSH»
//   #см("Сеть/SSH", якорь: "Туннели")        → «Туннели»
//   #см("Сеть/SSH", якорь: "Туннели")[про туннели]
//
// Путь — от корня хранилища, без `.typ`; книга — путь к её папке. Якорь —
// текст заголовка (как в Obsidian: «Смена порта») или имя метки.
//
// В HTML получается <a class="k-link" data-k-target data-k-anchor>: адрес
// ставит приложение, оно же проверяет, что заметка и заголовок существуют
// (`notes check`), и строит по этим ссылкам обратные ссылки и граф. В PDF
// ссылка — просто текст цвета акцента: других заметок в PDF нет.

#import "theme.typ": тема
#import "web.typ": веб, эл

#let см(путь, якорь: none, ..текст) = {
  assert(type(путь) == str, message: "см: путь — строка, например \"Сеть/SSH\"")
  assert(not путь.ends-with(".typ"), message: "см: путь без .typ: \"" + путь.trim(".typ", at: end) + "\"")
  assert(якорь == none or type(якорь) == str, message: "см: якорь — строка (текст заголовка или метка)")
  let надпись = текст.pos().at(0, default: if якорь != none { якорь } else { путь.split("/").last() })
  context if веб() {
    let атр = ("data-k-target": путь)
    if якорь != none { атр.insert("data-k-anchor", якорь) }
    html.elem("a", attrs: (class: "k-link") + атр, надпись)
  } else {
    text(fill: тема().цвет.акцент, надпись)
  }
}
