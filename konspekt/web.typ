// Помощники HTML-режима.
//
// Одна и та же заметка собирается в PDF (вёрстка страницами) и в HTML
// (сайт, приложение). В HTML-экспорте Typst нет страниц, а `grid`, `stack`,
// `align`, `place`, `v`, `h` игнорируются — вместе с содержимым. Поэтому у
// каждого блока библиотеки две ветки: PDF — как в konspekt-style, HTML —
// элементы с классами `k-…`, а вид задаёт CSS (`web/konspekt.css`).
//
// Цвета в HTML не вшиваются: их задают CSS-переменные темы. Исключение —
// рисунки (SVG из `html.frame`): заметка компилируется по разу на тему, и
// приложение склеивает варианты каждого `div.k-frame`.

/// HTML ли сейчас собираем. Только внутри `context`.
#let веб() = target() == "html"

/// Элемент с классом: эл("div", "k-box k-def", тело, style: "…").
#let эл(тег, класс, тело, ..атрибуты) = html.elem(тег, attrs: (class: класс) + атрибуты.named(), тело)

/// Рисунок как SVG в обёртке, которую находит склейка тем.
/// вид: "рис" — рисунок библиотеки (на экране чуть крупнее, см. CSS),
///      "вёрстка" — страховка для grid/stack/place: верстается шириной
///      текста страницы PDF, иначе колонки 1fr схлопываются в ноль.
#let кадр(тело, вид: "рис") = if вид == "рис" {
  эл("div", "k-frame k-fig", html.frame(тело))
} else {
  эл("div", "k-frame k-layout", html.frame(block(width: 21cm - 2 * 2.4cm, тело)))
}
