// Темы оформления.
//
// Тема — обычный словарь. Выбирается один раз в начале документа:
//   #show: конспект.with(тема: темы.классика, ...)
// Шаблон кладёт её в state, и все врезки, листинги и рисунки берут цвета
// и шрифты оттуда (внутри `context`). Поэтому одна и та же глава без правок
// верстается в любой теме.
//
// Своя тема: #let моя = настроить(темы.классика, (цвет: (акцент: rgb("#7a1f5c"))))
// — глубокое слияние, указывать нужно только то, что меняется.

// ── Глубокое слияние словарей ──────────────────────────────────────────────
#let настроить(база, изменения) = {
  let итог = база
  for (ключ, значение) in изменения {
    if ключ in итог and type(итог.at(ключ)) == dictionary and type(значение) == dictionary {
      итог.insert(ключ, настроить(итог.at(ключ), значение))
    } else {
      итог.insert(ключ, значение)
    }
  }
  итог
}

// ── Шрифты ────────────────────────────────────────────────────────────────
// Первый в списке — основной, остальные — запасные для недостающих глифов.
#let _текст-шрифты = ("Gentium Plus", "New Computer Modern")
#let _код-шрифты = ("JetBrains Mono", "DejaVu Sans Mono")

// Семантические цвета врезок: у каждой — насыщенный цвет (линия, подпись)
// и фон. Разные типы различаются ТОНОМ: конспект читают с экрана, врезка
// должна узнаваться боковым зрением до чтения подписи.
#let _врезки(акцент, пример, замечание, ошибка, идея, алгоритм, фон: 94%) = (
  опр: акцент,
  теорема: акцент.darken(15%),
  пример: пример,
  замечание: замечание,
  ошибка: ошибка,
  идея: идея,
  алгоритм: алгоритм,
  доля-фона: фон, // насколько осветлять цвет для заливки
)

// ═════════════════════════════════════════════════════════════════════════
// A. КЛАССИКА — основная тема: развитие конспекта по матану. Синий
//    акцент, врезки с полосой слева, книжный абзац с отступом.
// ═════════════════════════════════════════════════════════════════════════
#let классика = (
  имя: "классика",
  шрифт: (
    текст: _текст-шрифты,
    заголовки: _текст-шрифты,
    подписи: _текст-шрифты,
    матем: ("New Computer Modern Math",),
    код: _код-шрифты,
  ),
  кегль: (текст: 11pt, код: 8.8pt, мелкий: 9.2pt, глава: 25pt, раздел: 14pt, подраздел: 11.5pt),
  абзац: (интерлиньяж: 0.72em, отступ: 1.2em, интервал: 0.72em, выключка: true),
  страница: (поля: (x: 2.4cm, top: 2.6cm, bottom: 2.4cm)),
  цвет: (
    фон: white,
    текст: rgb("#1b1b1b"),
    приглушённый: rgb("#5f6670"),
    линия: rgb("#c9ced6"),
    поверхность: rgb("#f4f6f9"), // фон листингов, таблиц-шапок
    акцент: rgb("#1f4e79"),
    вторичный: rgb("#c62828"), // «спицы», выделения на рисунках
    врезки: _врезки(
      rgb("#1f4e79"), rgb("#2e7d32"), rgb("#b8860b"),
      rgb("#b3261e"), rgb("#00796b"), rgb("#6a4c93"),
      фон: 94%,
    ),
    код: (
      текст: rgb("#1b1b1b"), ключ: rgb("#1f4e79"), тип: rgb("#6a4c93"),
      строка: rgb("#2e7d32"), число: rgb("#b5561b"), коммент: rgb("#7b8490"),
      функция: rgb("#8a3b12"), выделение: rgb("#fff3c4"),
    ),
    рис: (
      линия: rgb("#1f4e79"), заливка: rgb("#1f4e79").lighten(82%),
      грань: rgb("#dce6f2"), второй: rgb("#c62828"), третий: rgb("#2e7d32"),
      ось: rgb("#1b1b1b"), сетка: rgb("#c9ced6"),
    ),
  ),
)

// ═════════════════════════════════════════════════════════════════════════
// ═════════════════════════════════════════════════════════════════════════
// B. НОЧЬ — та же «классика», перекрашенная для чтения с экрана в темноте.
//    Отличие ТОЛЬКО в палитре: шрифты, кегли, поля, заголовки, врезки и
//    колонтитулы те же. Один и тот же конспект в двух видах должен выглядеть
//    одним конспектом, а не двумя разными.
// ═════════════════════════════════════════════════════════════════════════
#let ночь = настроить(классика, (
  имя: "ночь",
  цвет: (
    фон: rgb("#16181e"),
    текст: rgb("#dde2ea"),
    приглушённый: rgb("#8a93a5"),
    линия: rgb("#343a48"),
    поверхность: rgb("#1f232c"),
    акцент: rgb("#7fb4ff"),
    вторичный: rgb("#ff9e64"),
    врезки: _врезки(
      rgb("#7fb4ff"), rgb("#69d3a0"), rgb("#f2c46d"),
      rgb("#ff8585"), rgb("#5fd0d6"), rgb("#b69cff"),
      // На тёмном фоне заливку врезки делаем прозрачностью, а не осветлением.
      фон: 0%,
    ),
    код: (
      текст: rgb("#d4d9e2"), ключ: rgb("#c099ff"), тип: rgb("#7fb4ff"),
      строка: rgb("#9ece6a"), число: rgb("#ff9e64"), коммент: rgb("#6b7489"),
      функция: rgb("#5fd0d6"), выделение: rgb("#2e3446"),
    ),
    рис: (
      линия: rgb("#7fb4ff"), заливка: rgb("#7fb4ff").transparentize(80%),
      грань: rgb("#26324a"), второй: rgb("#ff9e64"), третий: rgb("#69d3a0"),
      ось: rgb("#aab2c2"), сетка: rgb("#3a4152"),
    ),
  ),
))

#let темы = (классика: классика, ночь: ночь)

// ── Доступ к текущей теме ──────────────────────────────────────────────────
#let _тема = state("konspekt-тема", none)

/// Текущая тема. Вызывать только внутри `context`.
#let тема() = {
  let т = _тема.get()
  if т == none { классика } else { т }
}

/// Тёмная ли тема (по светлоте фона).
#let тёмная(т) = т.цвет.фон.components().at(0) < 50%

/// Бледный оттенок цвета для крупных «водяных» деталей (номер главы).
#let бледный(т, ц) = if тёмная(т) { ц.transparentize(88%) } else { ц.lighten(88%) }

/// Цвет заливки врезки данного вида с учётом темы (светлой или тёмной).
#let фон-врезки(т, цвет) = {
  if т.цвет.врезки.доля-фона == 0% { цвет.transparentize(90%) } else { цвет.lighten(т.цвет.врезки.доля-фона) }
}

// ── Цвета для CSS (HTML-режим) ────────────────────────────────────────────
// В HTML цвета задаёт CSS, но источник правды — эта же тема: сборщик
// забирает словарь из css.typ (typst query) и пишет CSS-переменные
// --k-<имя>. Производные цвета (фон врезки, бледный номер главы) считаются
// здесь теми же функциями, что и в PDF, — вид совпадает.
#let _css-врезки = (
  опр: "def", теорема: "thm", пример: "example", замечание: "remark",
  ошибка: "pitfall", идея: "idea", алгоритм: "algo",
)

#let css-цвета(т) = {
  let ц = т.цвет
  let в = ц.врезки
  let тёмн = тёмная(т)
  let итог = (
    bg: ц.фон, text: ц.текст, muted: ц.приглушённый, line: ц.линия,
    surface: ц.поверхность, accent: ц.акцент, second: ц.вторичный,
    accent-pale: бледный(т, ц.акцент),
    accent-bg: фон-врезки(т, ц.акцент),
    lead: ц.текст.transparentize(if тёмн { 5% } else { 10% }),
    step: в.пример.darken(if тёмн { 0% } else { 10% }),
    quiz-border: в.идея.lighten(if тёмн { 0% } else { 50% }).transparentize(if тёмн { 55% } else { 0% }),
    table-rule: ц.текст.transparentize(20%),
    table-head-rule: ц.текст.transparentize(30%),
  )
  for (вид, класс) in _css-врезки {
    итог.insert("box-" + класс, в.at(вид))
    итог.insert("box-" + класс + "-bg", фон-врезки(т, в.at(вид)))
  }
  for (имя, цвет) in (второй: ц.рис.второй, третий: ц.рис.третий, линия: ц.рис.линия) {
    итог.insert("hl-" + имя, if тёмн { цвет.transparentize(80%) } else { цвет.lighten(85%) })
  }
  for (ключ, имя) in (текст: "text", ключ: "key", тип: "type", строка: "string", число: "number", коммент: "comment", функция: "function", выделение: "hl") {
    итог.insert("code-" + имя, ц.код.at(ключ))
  }
  итог.pairs().map(((к, v)) => (к, v.to-hex())).to-dict()
}
