# Rust, Node
/target/
node_modules/
__pycache__/
# Данные приложения: хранилище и настройки (не код)
/data/
# Тестовое окружение: настройки, кэш, альбом снимков
/tests/.data/
# Клиент: сборка и отчёты тестов
/app/dist/
/app/test-results/
/app/playwright-report/
# Отдельный прогон тестов копии (.claude/rules/vendor.md)
/vendor/*/Cargo.lock
# Claude Code: личные настройки и рабочие копии (навыки .claude/skills - в git)
/.claude/settings.local.json
/.claude/worktrees/
