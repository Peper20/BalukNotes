{
  "project": "baluk notes",
  "guide": "docs/agents.md",
  "map": ".claude/rules/project.md",
  "forge": { "url": "http://localhost:3000", "repo": "ibaluk/baluk-notes" },
  "afterMerge": {
    "paths": ["crates/", "app/", "baluk/", "skills/"],
    "command": ["tools/install.sh"],
    "timeoutSeconds": 600
  },
  "check": {
    "steps": "tools/steps.sh",
    "env": "tools/lib/cpu-env.sh",
    "logs": "tests/.data/check",
    "heavyLock": "~/.cache/baluk-notes/heavy.lock"
  },
  "tests": [
    { "match": "^crates/([^/]+)/", "run": "tools/cargo.sh test -p $1" },
    { "match": "^app/", "run": "cd app && npm test && npm run -s check" },
    { "match": "^(tools|pipeline/scripts)/", "run": "tools/test-libs.sh" },
    { "match": "^pipeline/(hooks|tests)/", "run": "claude plugin test pipeline" }
  ],
  "targetedTests": "pipeline/scripts/test.sh"
}
