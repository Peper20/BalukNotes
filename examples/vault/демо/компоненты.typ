      кривая(t => 0.6 * calc.cos(t), t => 0.6 * calc.sin(t), 0, 2 * calc.pi, цвет: "второй", толщина: 0.8pt)
      точка((0.6, 0), подпись: $r$, якорь: "south-west", цвет: "второй")
      спица(0, -1, 1, гориз: true, цвет: "третий")
    }),
    зазор: 1.5em,
  ),
  [Седло $z = x^2 - y^2$ (сдвинутое): светотень и прозрачный каркас; справа —
