= Витрина компонентов

#лид[
  Все блоки, листинги и рисунки библиотеки на нескольких страницах — чтобы
  видеть, как они выглядят, и проверять, что ничего не сломалось. Эта глава —
  заглушка: её содержимое заменяется текстом конспекта.
]

#план([врезки и пример по шагам], [листинги и код из файла], [рисунки: 2D, 3D, массивы, таблицы, графы])

== Врезки

#опр(заголовок: "сходимости")[
  Последовательность $x_n$ сходится к $a$, если для любого $epsilon > 0$ найдётся
  $N$, начиная с которого $|x_n - a| < epsilon$.
]

#теорема(заголовок: "о двух милиционерах")[
  Если $a_n <= x_n <= b_n$ и $a_n, b_n -> a$, то и $x_n -> a$.
]

#доказательство[
  Для $epsilon > 0$ с некоторого номера $a - epsilon < a_n <= x_n <= b_n < a + epsilon$.
]

#идея[
  Неизвестное зажимают между двумя известными — и оно «вынуждено» сходиться туда же.
]

#пример(заголовок: "зажим синусом")[
  Найти $lim_(n -> oo) (sin n) / n$.

  #шаг[Оценка] $-1 / n <= (sin n) / n <= 1 / n$.

  #шаг[Пределы границ] Обе границы стремятся к нулю.

  #ответ[$0$]
]

#алгоритм(заголовок: "как расставлять пределы")[
  + Нарисовать область.
  + Выбрать направление «спицы».
  + Прочитать, через какие кривые спица входит и выходит.
]

#замечание[Десятичные дроби в формулах — через `dc`: $dc("0,5") + dc("0,25") = dc("0,75")$.]

#ошибка[Забыть, что $epsilon$ выбирается *до* $N$, а не после.]

#формула(подпись: "главное")[$ lim_(x -> 0) (sin x) / x = 1 $]

#на-полях[Заметка сбоку: то, что полезно знать, но что прервало бы рассказ.]
Абзац рядом с заметкой. Термины при первом появлении — *жирным*; встроенный код — `a[i] += 1`;
операторы в русской традиции: $tg x$, $arctg x$, $sh x$.

== Листинги

#листинг(
  подпись: [сортировка вставками],
  выделить: (4,),
  метки: ("4": 1),
  сложность: [$O(n^2)$ в худшем случае],
  ```python
  def insertion_sort(a):
      for i in range(1, len(a)):
          j = i
          while j > 0 and a[j - 1] > a[j]:
              a[j - 1], a[j] = a[j], a[j - 1]
              j -= 1
      return a
  ```,
)

Строка #метка(1) — сравнение соседей, пока элемент не встанет на место.

#код-из-файла("/демо/code/два-указателя.cpp", регион: "pair",
  подпись: [два указателя — из проверяемого файла], выделить: (7, 8), метки: ("7": 1, "8": 2),
  сложность: [$O(n)$])

== Алгоритм кадрами

Поиск пары с суммой $14$ в массиве двумя указателями: каждая строка — один шаг.

#let a = (1, 2, 4, 5, 7, 9, 11)
#let кадр(l, r, пояснение, цвет: "второй") = grid(
  columns: (auto, 1fr), column-gutter: 1.2em, align: horizon,
  холст(массив(a, клетка: 0.55, индексы: false,
    выделить: ((str(l)): цвет, (str(r)): цвет),
    указатели: ((l, $l$), (r, $r$)))),
  пояснение,
)
#рис(
  stack(spacing: 0.9em,
    кадр(0, 6, [$1 + 11 = 12 < 14$ → $l$ вправо]),
    кадр(1, 6, [$2 + 11 = 13 < 14$ → $l$ вправо]),
    кадр(2, 6, [$4 + 11 = 15 > 14$ → $r$ влево]),
    кадр(2, 5, [$4 + 9 = 13 < 14$ → $l$ вправо]),
    кадр(3, 5, [$5 + 9 = 14$ — нашли], цвет: "третий"),
  ),
  [Кадры работы двух указателей: указатель двигается в сторону, которая
   приближает сумму к цели; пар, которые мы пропускаем, ответ содержать не может],
)

#рис(
  холст(массив((3, 1, 4, 1, 5, 9, 2, 6), выделить: ("2": "линия", "3": "линия", "4": "линия", "5": "линия"),
    отрезки: ((2, 5, "линия", [окно $[2, 5]$]),), указатели: ((5, [конец]),))),
  [Массив с отрезком и указателем: окно $[2, 5]$ и его правый конец],
)

== Таблица ДП и графы

#let пути = ((1, 1, 1, 1, 1), (1, 2, 3, 4, 5), (1, 3, 6, 10, 15), (1, 4, 10, 20, 35))
#рядом(
  [
    Число путей из левого верхнего угла, если ходить только вправо и вниз:
    клетка равна сумме соседа сверху и соседа слева. Для угла $(4, 5)$:
    $35 = 15 + 20$. Таблицы ДП всегда рисуем с подсветкой переходов для
    клетки, которую разбираем в тексте.
  ],
  рис(холст(сетка(пути, клетка: 0.5, клетки: ("4,5": "линия", "3,5": "второй", "4,4": "второй"))),
    [Переход в клетку $(4, 5)$]),
  ширина: 42%,
)

#let дерево = (("1", "2"), ("1", "3"), ("2", "4"), ("2", "5"), ("3", "6"), ("3", "7"))
#let поз = раскладка-дерево(дерево, "1")
#let круг = раскладка-круг(("a", "b", "c", "d"), радиус: 1.1)
#рис(
  в-ряд(
    холст(граф(поз,
      дерево.map(e => (e.at(0), e.at(1), "выделено")) + (("4", "5", "пунктир"), ("5", "6", "пунктир"), ("6", "7", "пунктир")),
      выделить: ("1",),
      метки: ("1": ([$d = 0$], "west"), "3": ([$d = 1$], "west"), "7": ([$d = 2$], "west")))),
    холст(граф(круг,
      (("a", "b", "обычное", [3]), ("b", "c", "второе", [1]), ("c", "d", "обычное", [4]), ("d", "a", "обычное", [2]), ("b", "a", "тусклое", [5])),
      ориентированный: true, выделить: ("b",))),
    зазор: 3em,
  ),
  [Слева — дерево обхода в ширину (раскладка по уровням) и рёбра вне дерева
   пунктиром. Справа — ориентированный цикл с весами; встречные рёбра
   $a -> b$ и $b -> a$ разведены],
)

