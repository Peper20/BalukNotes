== Алгоритм кадрами

Поиск пары с суммой $14$ в массиве двумя указателями: каждая строка — один шаг.

#let a = (1, 2, 4, 5, 7, 9, 11)
#let frame(l, r, note-text, color: "second") = grid(
  columns: (auto, 1fr), column-gutter: 1.2em, align: horizon,
  canvas(array-cells(a, cell: 0.55, indices: false,
    highlight: ((str(l)): color, (str(r)): color),
    pointers: ((l, $l$), (r, $r$)))),
  note-text,
)
#fig(
  stack(spacing: 0.9em,
    frame(0, 6, [$1 + 11 = 12 < 14$ → $l$ вправо]),
    frame(1, 6, [$2 + 11 = 13 < 14$ → $l$ вправо]),
    frame(2, 6, [$4 + 11 = 15 > 14$ → $r$ влево]),
    frame(2, 5, [$4 + 9 = 13 < 14$ → $l$ вправо]),
    frame(3, 5, [$5 + 9 = 14$ — нашли], color: "third"),
  ),
  [Кадры работы двух указателей: указатель двигается в сторону, которая
   приближает сумму к цели; пар, которые мы пропускаем, ответ содержать не может],
)

#fig(
